# Crossmint — replace with your own keys before deploying to production
# Client-side key (browser, scope: orders.create)
VITE_CROSSMINT_CLIENT_API_KEY=ck_staging_your_key_here
# Server-side key (never expose in frontend; scopes: collections.create/read/update, nfts.create)
CROSSMINT_SERVER_API_KEY=sk_staging_your_key_here
# Collection ID used by the store
VITE_CROSSMINT_COLLECTION_ID=your_collection_id_here
