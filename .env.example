# Required Environment Variables for Netlify Deployment
# Copy this to .env.local for local development, or set in Netlify Dashboard → Site Settings → Environment Variables

# ============================================
# REQUIRED: Payment Provider API Keys
# ============================================
# Transak (get from https://transak.com)
TRANSAK_API_KEY=your_transak_api_key
TRANSAK_WEBHOOK_SECRET=your_transak_webhook_secret
NEXT_PUBLIC_TRANSAK_ENV=STAGING

# MoonPay (get from https://moonpay.com)
MOONPAY_API_KEY=your_moonpay_api_key
MOONPAY_SECRET_KEY=your_moonpay_secret_key
MOONPAY_WEBHOOK_SECRET=your_moonpay_webhook_secret

# Paybis (get from https://paybis.com)
PAYBIS_API_KEY=your_paybis_api_key
PAYBIS_WEBHOOK_SECRET=your_paybis_webhook_secret

# Onramper (aggregator - get from https://onramper.com)
ONRAMPER_API_KEY=your_onramper_api_key
ONRAMPER_WEBHOOK_SECRET=your_onramper_webhook_secret

# ============================================
# REQUIRED: Coinbase CDP (for NY/US users)
# ============================================
CDP_API_KEY_NAME=your_cdp_key_name
CDP_API_KEY_PRIVATE_KEY=your_cdp_private_key
NEXT_PUBLIC_CDP_PROJECT_ID=your_cdp_project_id

# ============================================
# REQUIRED: Wallet & Security
# ============================================
WALLET_ADDRESS=0xe4c3a86276c87bbe8b9d8a1aff199bb696b5cf53
JWT_SECRET=your_32_char_jwt_secret_min_32_chars

# ============================================
# OPTIONAL: Email Service
# ============================================
SENDGRID_API_KEY=your_sendgrid_api_key

# ============================================
# REQUIRED: Site URL
# ============================================
NEXT_PUBLIC_APP_URL=https://cognibook.netlify.app
URL=https://cognibook.netlify.app

# ============================================
# OPTIONAL: Onramper Aggregator
# ============================================
ONRAMPER_API_KEY=your_onramper_api_key
ONRAMPER_WEBHOOK_SECRET=your_onramper_webhook_secret